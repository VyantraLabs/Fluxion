{
  "name": "@fluxion/shared-lib",
  "version": "1.0.0",
  "description": "Shared library for Fluxion microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils/logger": {
      "require": "./dist/utils/logger.js",
      "types": "./dist/utils/logger.d.ts"
    },
    "./utils/response": {
      "require": "./dist/utils/response.js",
      "types": "./dist/utils/response.d.ts"
    },
    "./middleware": {
      "require": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./auth": {
      "require": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./types/common": {
      "require": "./dist/types/common.js",
      "types": "./dist/types/common.d.ts"
    },
    "./errors": {
      "require": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./validation": {
      "require": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "migration:generate": "ts-node src/database/cli.ts migration:generate",
    "migration:run": "ts-node src/database/cli.ts migration:run",
    "migration:revert": "ts-node src/database/cli.ts migration:revert",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "typeorm": "^0.3.17",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0",
    "winston": "^3.10.0",
    "zod": "^3.22.0",
    "jsonwebtoken": "^9.0.0",
    "ethers": "^6.7.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "rate-limiter-flexible": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "ulid": "^2.3.0",
    "dotenv": "^16.3.0",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-express": "^5.0.0",
    "aws-sdk": "^2.1400.0",
    "@aws-sdk/client-sqs": "^3.888.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/jest": "^29.5.0",
    "@types/swagger-jsdoc": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  }
}