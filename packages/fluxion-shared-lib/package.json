{
  "name": "@fluxion/shared-lib",
  "version": "1.0.0",
  "description": "Shared library for Fluxion microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils/logger": {
      "require": "./dist/utils/logger.js",
      "types": "./dist/utils/logger.d.ts"
    },
    "./utils/response": {
      "require": "./dist/utils/response.js",
      "types": "./dist/utils/response.d.ts"
    },
    "./middleware": {
      "require": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./middleware/simple-auth": {
      "require": "./dist/middleware/simple-auth.js",
      "types": "./dist/middleware/simple-auth.d.ts"
    },
    "./config/service-router": {
      "require": "./dist/config/service-router.js",
      "types": "./dist/config/service-router.d.ts"
    },
    "./types/common": {
      "require": "./dist/types/common.js",
      "types": "./dist/types/common.d.ts"
    },
    "./errors": {
      "require": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./validation": {
      "require": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    },
    "./lambda": {
      "require": "./dist/lambda/index.js",
      "types": "./dist/lambda/index.d.ts"
    },
    "./lambda/adapter": {
      "require": "./dist/lambda/adapter.js",
      "types": "./dist/lambda/adapter.d.ts"
    },
    "./lambda/types": {
      "require": "./dist/lambda/types.js",
      "types": "./dist/lambda/types.d.ts"
    },
    "./lambda/utils": {
      "require": "./dist/lambda/utils.js",
      "types": "./dist/lambda/utils.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "migration:generate": "ts-node src/database/cli.ts migration:generate",
    "migration:run": "ts-node src/database/cli.ts migration:run",
    "migration:revert": "ts-node src/database/cli.ts migration:revert",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "typeorm": "^0.3.21",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "ioredis": "^5.4.2",
    "winston": "^3.17.0",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "ethers": "^6.15.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "rate-limiter-flexible": "^7.3.2",
    "reflect-metadata": "^0.2.2",
    "ulid": "^3.0.1",
    "dotenv": "^16.4.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "@aws-sdk/client-sqs": "^3.724.0",
    "@aws-sdk/client-lambda": "^3.724.0",
    "@types/aws-lambda": "^8.10.0",
    "@codegenie/serverless-express": "^4.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/jest": "^29.5.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}