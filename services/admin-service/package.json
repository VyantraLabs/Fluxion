{
  "name": "@fluxion/admin-service",
  "version": "1.0.0",
  "description": "Admin API service for Fluxion platform",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "dev": "npm run start:dev",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "typeorm": "TS_NODE_PROJECT=tsconfig.migrations.json typeorm-ts-node-commonjs -d src/database/cli-data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/index.ts",
    "build:lambda": "npm run build && node ../../scripts/lambda-build.js build admin-service",
    "deploy:dev": "npm run build:lambda && sam deploy --config-env dev --parameter-overrides Environment=dev",
    "deploy:staging": "npm run build:lambda && sam deploy --config-env staging --parameter-overrides Environment=staging",
    "deploy:prod": "npm run build:lambda && sam deploy --config-env production --parameter-overrides Environment=production",
    "package:lambda": "sam package --template-file template.yaml --s3-bucket fluxion-deployments-${ENVIRONMENT:-dev} --output-template-file packaged-template.yaml",
    "validate:template": "sam validate --template-file template.yaml",
    "logs:tail": "sam logs --name fluxion-${ENVIRONMENT:-dev}-admin-service --tail",
    "invoke:local": "sam local invoke AdminServiceFunction --event events/api-gateway-event.json"
  },
  "dependencies": {
    "@fluxion/shared-lib": "workspace:*",
    "@aws-sdk/client-cloudwatch-logs": "^3.724.0",
    "@aws-sdk/client-s3": "^3.724.0",
    "@aws-sdk/client-sqs": "^3.724.0",
    "@aws-sdk/lib-storage": "^3.724.0",
    "@aws-sdk/s3-request-presigner": "^3.724.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.21",
    "ulid": "^3.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}