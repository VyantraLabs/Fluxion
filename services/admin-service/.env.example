# Admin Service Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3001
VERSION=1.0.0

# API Configuration - Configurable Base Path
ADMIN_BASE_PATH=/admin
# Alternative examples:
# ADMIN_BASE_PATH=/administration
# ADMIN_BASE_PATH=/manage
# ADMIN_BASE_PATH=/console

# Database Configuration (shared with main service)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=fluxion_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (should match main service)
JWT_SECRET=your-secret-key-for-development
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=debug

# Notification Queue
NOTIFICATION_QUEUE_URL=

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

# Rate Limiting (stricter for admin)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50