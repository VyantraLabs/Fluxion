# Admin Frontend Environment Variables

# Development Port Configuration
PORT=3003

# API Configuration - Microservices with Configurable Base Path
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_BASE_PATH=/admin

# Alternative admin base path examples:
# NEXT_PUBLIC_ADMIN_BASE_PATH=/administration
# NEXT_PUBLIC_ADMIN_BASE_PATH=/manage
# NEXT_PUBLIC_ADMIN_BASE_PATH=/console

# Legacy support
NEXT_PUBLIC_MAIN_SERVICE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Environment
NODE_ENV=development

# Admin Configuration
NEXT_PUBLIC_APP_NAME="Fluxion Admin"
NEXT_PUBLIC_MAINTENANCE_MODE=false