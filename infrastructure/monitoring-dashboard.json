{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/Lambda", "Invocations", "FunctionName", "fluxion-main-prod", { "stat": "Sum" } ],
          [ ".", "Duration", ".", ".", { "stat": "Average" } ],
          [ ".", "Errors", ".", ".", { "stat": "Sum" } ],
          [ ".", "Throttles", ".", ".", { "stat": "Sum" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "title": "Main Lambda Performance",
        "period": 300,
        "annotations": {
          "horizontal": [
            {
              "label": "Error Threshold",
              "value": 5
            }
          ]
        }
      }
    },
    {
