# Environment Configuration for Fluxion Notification Lambda
# Copy this file to .env and update with your actual values

# Development Environment
NODE_ENV=development
PORT=3001

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key  # Optional - Lambda will use IAM role
AWS_SECRET_ACCESS_KEY=your-aws-secret-key  # Optional - Lambda will use IAM role

# SES Configuration (for sending emails)
SES_REGION=us-east-1
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Fluxion

# Logging Configuration
LOG_LEVEL=debug

# Optional: Local development email testing
# Use a test email address during development
# FROM_EMAIL=test@yourdomain.com
# FROM_NAME="Fluxion Dev"

# Optional: SMTP Configuration (alternative to SES for local testing)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password