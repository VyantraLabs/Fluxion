# Environment Configuration
NODE_ENV=development
STAGE=dev
PORT=3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluxion_local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=fluxion_local
DB_SSL=false
DB_LOGGING=true

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Authentication Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Multi-tenancy Features
DEFAULT_ORGANIZATION_ID=org_default_12345
ENABLE_RLS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_REDIS_CACHE=false

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Configuration for Template Storage
# REQUIRED: Set these for template storage to work
S3_BUCKET_NAME=your-s3-bucket-name
S3_BUCKET_URL=https://your-s3-bucket-name.s3.your-region.amazonaws.com
S3_REGION=ap-south-1

# SQS Configuration for Notifications
NOTIFICATION_QUEUE_URL=https://sqs.your-region.amazonaws.com/your-account/your-queue-name

# Blockchain Configuration
# RPC URLs for different networks
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key

# Token Contract Addresses (these will be moved to database)
POLYGON_USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
ETHEREUM_USDC_CONTRACT=0xA0b86a33E6417e5F3D7B4FA56E4D0e5F3b5c8e4F

# Default blockchain network
DEFAULT_BLOCKCHAIN_NETWORK=polygon

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid Configuration (alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# AWS SES Configuration (alternative)
SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@yourdomain.com

# Monitoring & Analytics
ENABLE_METRICS=true
SENTRY_DSN=your-sentry-dsn-url

# Development/Testing
SKIP_AUTH_IN_DEV=false
MOCK_BLOCKCHAIN_CALLS=false