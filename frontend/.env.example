# API Configuration
NEXT_PUBLIC_API_URL=https://api.fluxion.pay
NEXT_PUBLIC_API_VERSION=v1

# Environment
NEXT_PUBLIC_ENV=development

# Frontend URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Blockchain Configuration
NEXT_PUBLIC_DEFAULT_CHAIN_ID=137
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# USDC Contract Addresses
NEXT_PUBLIC_USDC_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
NEXT_PUBLIC_USDC_MUMBAI=0x9999f7fea5938fd3b1e26a12c3f2fb024e194f97

# Alchemy/Infura (Optional - for better RPC reliability)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_INFURA_PROJECT_ID=your_infura_project_id_here

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=your_google_analytics_id_here
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Sentry Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Rate Limiting
NEXT_PUBLIC_MAX_REQUESTS_PER_MINUTE=60

# File Upload (if needed)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=5

# Debug Mode
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_VERBOSE_LOGGING=false